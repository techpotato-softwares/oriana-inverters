QA_DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
QA_DB_PORT=6543
QA_DB_NAME=postgres
QA_DB_USER=postgres.tmjrpkliwrtpisudsfpj
QA_DB_SSL=true

# PROD (RDS)
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_NAME=oriana
PROD_DB_USER=oriana_admin
PROD_DB_SSL=true
