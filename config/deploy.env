# Single environment file for all deploy targets
# Update this file before running deploy workflow.

# DEV
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=oriana
DEV_DB_USER=postgres
DEV_DB_SSL=false

# QA (Supabase — use transaction-mode pooler :6543 for Lambda/serverless.
