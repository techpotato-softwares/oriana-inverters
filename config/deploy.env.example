# Non-secret connection metadata only (hosts/users).
# Passwords and Payload secrets live in AWS Secrets Manager — never commit them,
# and do not store them as GitHub Actions secrets (only AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY belong in GitHub).

# DEV
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=oriana
DEV_DB_USER=postgres
DEV_DB_SSL=false
DEV_DB_SCHEMA=public

# QA (Supabase — prefer transaction pooler :6543 for Lambda)
QA_DB_HOST=aws-0-<region>.pooler.supabase.com
QA_DB_PORT=6543
QA_DB_NAME=postgres
QA_DB_USER=postgres.<project-ref>
QA_DB_SSL=true
QA_DB_SCHEMA=public

# PROD — managed by CDK shared RDS `oriana-web`.
# Host/user/password/schema are written automatically by:
#   scripts/sync-rds-app-secret.sh → /oriana-invertors-web/prod/database
# Do not put PROD_DB_PASSWORD here.
PROD_DB_SCHEMA=oriana_invertors
