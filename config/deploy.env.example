# Single environment file for all deploy targets
# Fill host/user per environment. Keep passwords out of git.
# DB_PASSWORD is managed in AWS Secrets Manager by placeholder update.

# DEV
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=oriana
DEV_DB_USER=postgres
DEV_DB_SSL=false

# QA (Supabase)
QA_DB_HOST=db.xxxx.supabase.co
QA_DB_PORT=5432
QA_DB_NAME=postgres
QA_DB_USER=postgres
QA_DB_SSL=true

# PROD (RDS)
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_NAME=oriana
PROD_DB_USER=oriana_admin
PROD_DB_SSL=true
