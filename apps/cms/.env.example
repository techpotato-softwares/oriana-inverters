# Postgres (local / Supabase QA / RDS prod)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oriana
# First-time schema bootstrap only (prefer migrations in CI):
# PAYLOAD_DATABASE_PUSH=true

PAYLOAD_SECRET=change-me-to-a-random-32-char-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=change-me
PREVIEW_SECRET=change-me

# S3 media (optional locally; required on AWS)
# On AWS, Payload uses clientUploads (presigned PUT) so files bypass the Lambda 6MB body limit.
# S3_BUCKET=oriana-invertors-web-media-qa
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Admin seed (seed:admin / GitHub Actions)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
